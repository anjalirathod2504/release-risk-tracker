{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Build database",
      "type": "debugpy", "request": "launch",
      "module": "release_risk.cli", "args": ["build"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "2. Build release review report",
      "type": "debugpy", "request": "launch",
      "module": "release_risk.cli", "args": ["report"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests",
      "type": "debugpy", "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
